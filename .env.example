# Database
DB_HOST=db-host
DB_PORT=db-port
DB_NAME=db-name
DB_USERNAME=db-username
DB_PASSWORD=db-password

# DB Connection & Pool Tuning (Optional - sane defaults provided)
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# DB_ECHO=false
# DB_STATEMENT_CACHE_SIZE=0
# DB_SYNC_POOL_SIZE=5
# DB_SYNC_MAX_OVERFLOW=5
# DB_ASYNC_POOL_SIZE=20
# DB_ASYNC_MAX_OVERFLOW=10
# DB_WORKER_POOL_SIZE=10
# DB_WORKER_MAX_OVERFLOW=5

# Redis
REDIS_HOST=redis-host
REDIS_PORT=redis-port
REDIS_PASSWORD=redis-password
REDIS_USERNAME=redis-username
REDIS_DB=redis-db
REDIS_ENABLED_SSL=redis-enabled-ssl

# Redis Connection & Pool Tuning (Optional - sane defaults provided)
# REDIS_SOCKET_TIMEOUT=5.0
# REDIS_SOCKET_CONNECT_TIMEOUT=5.0
# REDIS_HEALTH_CHECK_INTERVAL=30
# REDIS_RETRY_ON_TIMEOUT=true
# REDIS_DECODE_RESPONSES=true
# REDIS_ASYNC_MAX_CONNECTIONS=50
# REDIS_SYNC_MAX_CONNECTIONS=20

API_KEY_PEPPER=change-me-to-a-secure-key
ENDPOINT_SECRET_ENCRYPTION_KEY=change-me-to-a-secure-key

ALLOWED_HOSTS=*

# CORS Configuration (Optional - sane defaults provided)
# CORS_ENABLED=true
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ORIGIN_REGEX=^https:\/\/.*\.example\.com$
# CORS_ALLOW_CREDENTIALS=true
# CORS_MAX_AGE=600

# API Documentation Configuration (Optional - strictly disabled in production, configurable in dev/staging)
# DOCS_ENABLED=true
# DOCS_URL_PATH=/docs
# REDOC_URL_PATH=/redoc
# OPENAPI_URL_PATH=/openapi.json
